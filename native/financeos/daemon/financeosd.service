[Unit]
Description=FinanceOS local API daemon (Flask/gunicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/financeos/app
Environment=FINANCEOS_HOST=127.0.0.1
Environment=FINANCEOS_PORT=5000
Environment=FLASK_DEBUG=0
ExecStart=%h/.local/share/financeos/app/native/financeos/daemon/financeosd.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
